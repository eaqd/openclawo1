// ~/.openclaw/openclaw.json
// OpenClaw + Ollama Configuration (free local LLM)
// Docs: https://docs.openclaw.ai/gateway/configuration
//
// Valid root keys: gateway, agents, models, channels, commands,
// auth, env, plugins, hooks, cron, skills
{
  gateway: {
    mode: "local",
  },

  models: {
    default: "ollama/qwen3.5:4b",
    providers: {
      ollama: {
        apiBase: "http://localhost:11434/v1",
        type: "openai-compatible",
      },
    },
  },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: {
        primary: "ollama/qwen3.5:4b",
        fallbacks: ["ollama/qwen3.5:2b", "ollama/qwen3.5:0.8b"],
        reasoning: false,  // Qwen 3.5 "thinking" mode can cause empty streaming responses
      },
      memorySearch: {
        enabled: false,  // requires an embedding provider; enable if you add one
      },
    },
  },

  // Uncomment and fill in to enable Telegram:
  // channels: {
  //   telegram: {
  //     enabled: true,
  //     botToken: "YOUR_BOT_TOKEN",
  //     allowFrom: ["YOUR_USER_ID"],
  //     groups: { "*": { requireMention: true } },
  //   },
  // },
}
