{
  // OpenClaw Configuration — Ollama (Local LLM)
  // Docs: https://docs.openclaw.ai/providers/ollama

  // ── Model Provider ────────────────────────────────────────
  models: {
    providers: {
      ollama: {
        baseUrl: "http://ollama:11434",
        apiKey: "ollama-local",
        api: "ollama",  // Native Ollama API — required for reliable tool calling
        models: [
          {
            id: "qwen2.5-coder:3b",
            name: "Qwen 2.5 Coder 3B",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,
            maxTokens: 8192
          },
          {
            id: "phi3:mini",
            name: "Phi-3 Mini",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 4096,
            maxTokens: 4096
          }
        ]
      }
    }
  },

  // ── Agent Defaults ────────────────────────────────────────
  agents: {
    defaults: {
      model: {
        primary: "ollama/qwen2.5-coder:3b",
        fallbacks: ["ollama/phi3:mini"]
      }
    }
  },

  // ── Channels ──────────────────────────────────────────────
  channels: {
    terminal: {
      enabled: true
    },
    telegram: {
      enabled: true,
      configFile: "telegram.json5"
    }
  },

  // ── Skills ────────────────────────────────────────────────
  skills: {
    bundled: true,
    extraDirs: [
      "/home/node/.openclaw/skills"
    ]
  },

  // ── General ───────────────────────────────────────────────
  logging: {
    level: "info"
  }
}
